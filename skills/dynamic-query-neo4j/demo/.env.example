# Optional but recommended: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

NEO4J_PASSWORD=openfda-demo
SEED_TERMS=adalimumab,trastuzumab,pembrolizumab
MAX_APPLICATIONS=20
OPENFDA_LIMIT=100

# "latest" discovers the newest valid monthly Purple Book CSV from FDA.
PURPLEBOOK_URL=latest

# FDA's stable URL for the current Orange Book products/patent/exclusivity ZIP.
ORANGEBOOK_URL=https://www.fda.gov/media/76860/download
